generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model circle_texts {
  id             Int      @id @default(autoincrement())
  connected_text String
  page_number    Int
  created_at     DateTime @default(now())
}

model single_road_texts {
  id          Int      @id @default(autoincrement())
  road_text   String
  page_number Int
  created_at  DateTime @default(now())
}

model di_tile_ocr {
  id          Int      @id @default(autoincrement())
  page_number Int
  tile_id     String
  ocr_data    Json
  created_at  DateTime @default(now())
}
